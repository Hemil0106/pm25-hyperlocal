# Copy this file to `.env` and fill in credentials (`.env` is gitignored).
#
# NOTE: This SIH prototype currently runs in FALLBACK mode because AOD data
# is unavailable in the demonstration environment. If you configure NASA
# Earthdata credentials, set download.enabled=true in config.yaml to allow
# the AOD/NDVI/DEM/VIIRS download stages to reach the DAACs.

# NASA Earthdata Login (https://urs.earthdata.nasa.gov) - for MODIS MAIAC AOD,
# MODIS NDVI, SRTM DEM and VIIRS night-lights downloads.
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# Copernicus Climate Data Store - for ERA5-Land weather downloads
# (only needed if the weather NetCDF is not already provided in data/raw/weather).
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# Central Pollution Control Board API (optional; not required when the
# raw CPCB CSV is already provided in data/raw/cpcb).
CPCB_API_URL=
